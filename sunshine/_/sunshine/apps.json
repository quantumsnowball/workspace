{
    "apps": [
        {
            "image-path": "desktop.png",
            "name": "Desktop"
        },
        {
            "image-path": "desktop.png",
            "name": "Low Res Desktop",
            "prep-cmd": [
                {
                    "do": "xrandr --output HDMI-1 --mode 1920x1080",
                    "undo": "xrandr --output HDMI-1 --mode 1920x1200"
                }
            ]
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "",
            "name": "s7-hd",
            "output": "",
            "prep-cmd": [
                {
                    "do": "niri msg create-virtual-output --name HEADLESS-1 --width 1920 --height 1200 --refresh-rate 60",
                    "undo": "niri msg remove-virtual-output HEADLESS-1"
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "",
            "name": "s7-2k",
            "output": "",
            "prep-cmd": [
                {
                    "do": "niri msg create-virtual-output --name HEADLESS-1 --width 2560 --height 1600 --refresh-rate 60",
                    "undo": "niri msg remove-virtual-output HEADLESS-1"
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "",
            "name": "s7-hd (exclusive)",
            "output": "",
            "prep-cmd": [
                {
                    "do": "niri msg create-virtual-output --name HEADLESS-1 --width 1920 --height 1200 --refresh-rate 60",
                    "undo": "niri msg remove-virtual-output HEADLESS-1"
                },
                {
                    "do": "niri msg output HDMI-A-1 off",
                    "undo": "niri msg output HDMI-A-1 on"
                }
            ],
            "wait-all": true
        },
        {
            "detached": [
                "setsid steam steam://open/bigpicture"
            ],
            "image-path": "steam.png",
            "name": "Steam Big Picture",
            "prep-cmd": [
                {
                    "do": "",
                    "undo": "setsid steam steam://close/bigpicture"
                }
            ]
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    }
}
