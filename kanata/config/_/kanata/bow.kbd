;; select device
(defcfg
    linux-dev (
        "/dev/input/by-id/usb-_2.4G_Wireless_Device_EB60121120040902-event-kbd"
    )
    linux-output-device-name "Kanata: BOW Keyboard"
    windows-interception-keyboard-hwids (
    )
    process-unmapped-keys yes
)

;; define aliases
(defalias
    vim (layer-while-held vim-layer)
    media (layer-while-held media-layer)
)

;; define source
;;   key names ref:
;;   https://github.com/jtroo/kanata/blob/main/parser/src/keys/mod.rs
(defsrc
;;
    grv
;;
    esc       1         2         3         4         5         6         7         8         9         0         -         =         bspc       home
;;
    tab        q         w         e         r         t         y         u         i         o         p         [         ]         \         del
;;
    caps        a         s         d         f         g         h         j         k         l         ;         '         ret                pgup
;;
    lsft         z         x         c         v         b         n         m         ,         .         /         rsft             up         pgdn
;;
    lctl      lmet      lalt                            spc                             ralt                rctl         left        down        right
)

;; default layer
(deflayer default
;;
    caps
;;
    grv       _         _         _         _         _         _         _         _         _         _         _         _         _          del
;;
    _          _         _         _         _         _         _         _         _         _         _         _         _         _         home
;;
    esc         _         _         _         _         _         _         _         _         _         _         _         _                  _
;;
    _            _         _         _         _         _         _         _         _         _         _         _                _          _
;;                                                                                      vim-layer           media-layer
    lmet      lalt      lctl                            _                               @vim                @media       _           _           _
)
;; vim layer
(defalias
    ;; close tab / reopen tab when shifted
    opClTab (fork C-w C-S-t (lsft rsft))
)
(deflayer vim-layer
;;
    _
;;  prevTab   work1     work2     work3     work4     work5     work6     work7     work8     work9               prevURL   nextURL   prevTab    closeTab
    C-S-tab   M-1       M-2       M-3       M-4       M-5       M-6       M-7       M-8       M-9       _         A-left    A-right   C-S-tab    C-w
;;  nextTab              nextWord                                                                                                      nextTab   rstrTab
    C-tab      _         C-right   _         _         _         _         _         _         _         _         _         _         C-tab     C-S-t
;;  newTab                          delWord                                                                         tgBmBar   newTab             bmPage
    C-t         _         _         C-del     _         _         left      down      up        right     _         C-S-b     C-t                C-S-o
;;                                   delWord             prevWord                                          tgVTabW                               clPage
    _            _         _         C-del     _         C-left    home      pgdn      pgup      end       C-S-l     _                _          C-j
;;                                                      tgVTabW
    _         _         _                               C-S-l                           _                   _            _           _           _
)
;; media layer
(deflayer media-layer
;;
    _
;;            ctrlF1    ctrlF2    ctrlF3    ctrlF4    reloadCfg                                                                       powerMenu  lockPC
    _         C-f1      C-f2      C-f3      C-f4      lrld      _         _         _         _         _         _         _         M-bspc     M-del
;;                                                                                                                 prevMedia nextMedia
    _          _         _         _         _         _         _         _         _         _         _         prev      next      _         _
;;                                                                                                                  volume+
    _           _         _         _         _         _         _         _         _         _         _         volu      _                  _
;;                                                                                               pause     volume-                    workUp
    _            _         _         _         _         _         _         _         _         pp        vold      _                M-A-up     _
;;                                                                                                                       workLeft    workDown    workRight
    _         _         _                               _                               _                   _            M-A-left    M-A-down    M-A-right
)
