;; define aliases
(defalias
    z_layer (layer-while-held z-layer)
    x_layer (layer-while-held x-layer)
)

;; define source
;;   key names ref:
;;   https://github.com/jtroo/kanata/blob/main/parser/src/keys/mod.rs
(defsrc
;;
    q         lctl                lsft                                    spc                 e
;;
    w         a         s         d                             tab       f1                  z
;;
                        1         5                                                           x
;;
    4         8                             2         6         m         f2                  lalt
;;
                        3         7                   esc       ret                 c         r
;;
    b         t                             g         h                             v         f
)

;; default layer
(deflayer default
;;
    _         _                   _                                       _                   _
;;
    _         _         _         _                             _         _                   @z_layer
;;
                        _         _                                                           @x_layer
;;
    _         _                             _         _         _         _                   _
;;
                        _         _                   _         _                   _         _
;;
    _         _                             _         _                             _         _
)
;; z layer
(deflayer z-layer
;;
    z         _                   _                                       _                   _
;;
    up        left      down      right                         o         _                   _
;;
                        _         _                                                           _
;;
    _         _                             _         _         i         _                   _
;;
                        _         _                   _         _                   _         _
;;
    y         _                             u         _                             _         _
)
;; x layer
(deflayer x-layer
;;
    x         _                   _                                       _                   _
;;
    up        left      down      right                         p         _                   _
;;
                        _         _                                                           _
;;
    _         _                             _         _         l         _                   _
;;
                        _         _                   _         _                   _         _
;;
    j         _                             k         _                             _         _
)
