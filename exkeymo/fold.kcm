type OVERLAY

# capslock -> esc
map key 58 ESCAPE
# lctrl -> lmeta
map key 29 META_LEFT
# lmeta -> lctrl
map key 125 CTRL_LEFT


# RightAlt + HJKL Arrow Keys
key H {
    label: 'h'
    base: 'h'
    shift, capslock: 'H'
    rmeta: replace DPAD_LEFT
    shift+rmeta: replace DPAD_LEFT
}
key J {
    label: 'j'
    base: 'j'
    shift, capslock: 'J'
    rmeta: replace DPAD_DOWN
    shift+rmeta: replace DPAD_DOWN
}
key K {
    label: 'k'
    base: 'k'
    shift, capslock: 'K'
    rmeta: replace DPAD_UP
    shift+rmeta: replace DPAD_UP
}
key L {
    label: 'l'
    base: 'l'
    shift, capslock: 'L'
    rmeta: replace DPAD_RIGHT
    shift+rmeta: replace DPAD_RIGHT
}

# RightAlt + NM,. Navigation
key N {
    label: 'n'
    base: 'n'
    shift, capslock: 'N'
    rmeta: replace MOVE_HOME
    shift+rmeta: replace MOVE_HOME
}
key M {
    label: 'm'
    base: 'm'
    shift, capslock: 'M'
    rmeta: replace PAGE_DOWN
    shift+rmeta: replace PAGE_DOWN
}
key COMMA {
    label: ','
    base: ','
    shift: '<'
    rmeta: replace PAGE_UP
    shift+rmeta: replace PAGE_UP
}
key PERIOD {
    label: '.'
    base: '.'
    shift: '>'
    rmeta: replace MOVE_END
    shift+rmeta: replace MOVE_END
}

