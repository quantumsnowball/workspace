
extra-keys = [[ \
    {key: KEYBOARD}, \
    {key: TAB}, \
    {key: LEFT, popup: HOME}, \
    {key: DOWN, popup: PGDN}, \
    {key: ESC, popup: {macro: 'CTRL c', display: '^C'}}, \
    {key: ESC, popup: {macro: 'CTRL c', display: '^C'}}, \
    {key: UP, popup: PGUP}, \
    {key: RIGHT, popup: END}, \
    {key: BACKSPACE, popup: {macro: 'ALT u', display: 'M-u'}}, \
    {key: ENTER, popup: '.'} \
]]

# vim: ft=sh
