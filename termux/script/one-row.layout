
extra-keys = [[ \
    {key: KEYBOARD}, \
    {key: TAB}, \
    {key: LEFT, popup: HOME}, \
    {key: DOWN, popup: PGDN}, \
    {key: ESC, popup: TAB}, \
    {key: ESC, popup: TAB}, \
    {key: UP, popup: PGUP}, \
    {key: RIGHT, popup: END}, \
    {key: BACKSPACE, popup: '-'}, \
    {key: ENTER, popup: '/'} \
]]

