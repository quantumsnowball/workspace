#!/usr/bin/env bash

# define chrome launch flags
flags=(
    # wallet integration
    --password-store=kwallet6

    # wayland display server
    --ozone-platform=wayland

    # force to D129, the intel GPU, because nvidia vaapi driver is broken
    --render-node-override=/dev/dri/renderD129
    --use-gl=desktop

    # hardware acceleration features
    --enable-features=VaapiVideoDecoder,VaapiVideoEncoder,CanvasOopRasterization,VaapiIgnoreDriverChecks,WaylandLinuxDrmSyncobj
    --disable-features=UseChromeOSDirectVideoDecoder,Vulkan
    --disable-gpu-driver-bug-workarounds
)

exec /opt/google/chrome/google-chrome "${flags[@]}" "$@"
